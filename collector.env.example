# 复制本文件为 collector.env，然后填写实际 API 信息。
# collector.env 已被 .gitignore 排除，不会随代码提交。
ROBOCOIN_VLM_BACKEND=api
ROBOCOIN_REQUIREMENTS_FILE=requirements-collector.txt
VLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=请填写GLM_API密钥
VLM_MODEL=glm-5.3-flash
ROBOCOIN_NOUN_REVIEW=1

# 可选：API 并发数。数采电脑默认 4 通常比较稳妥。
VLM_API_CONCURRENCY=4
